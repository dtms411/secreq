# SecReq investigation environment — LOCAL CLI HOST ONLY.
# Copy to `.env` (never commit it). These secrets live only on the machine that
# runs the backfill; they are NEVER added to Vercel or reachable by the browser.

# The investigation Supabase project (separate from BoroBeacon).
SUPABASE_URL=https://<investigation-project>.supabase.co

# Service role key — full database access. Local CLI only. Never in Vercel,
# never in the web app, never pasted into chat.
SUPABASE_SERVICE_KEY=

# Who is running the CLI (stamped into the append-only audit log).
RECON_ACTOR=kharry

# Enables the accurate Claude-vision read in the OCR consensus gate. Without it
# the gate still runs on tesseract-only consensus (it just quarantines more).
# Local CLI only — like the service key, it must never go to Vercel/the browser.
ANTHROPIC_API_KEY=

# Optional: override the vision model (default claude-opus-4-8).
# SECREQ_VISION_MODEL=claude-opus-4-8
